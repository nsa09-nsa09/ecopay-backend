# EcoPay backend production environment for Dokploy.
# Copy variable names into Dokploy Environment and fill real values there.
# Do not commit real secrets.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=ecopay
POSTGRES_USER=ecopay
POSTGRES_PASSWORD=<strong database password>
POSTGRES_URL_PARAMS=?sslmode=require
JPA_DDL_AUTO=validate

# Public HTTPS origins, no trailing slash
APP_BASE_URL=https://api.example.com
APP_FRONTEND_URL=https://app.example.com
APP_PUBLIC_URL=https://app.example.com
APP_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_SUPPORT_EMAIL=support@example.com
APP_BRAND_NAME=EcoPay

# JWT and field encryption. Generate base64 secrets with at least 32 decoded bytes.
JWT_SECRET=<base64 random 32+ bytes>
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
APP_SECURITY_FIELD_ENCRYPTION_KEY=<base64 random 32 bytes>
APP_AUTH_REFRESH_COOKIE_SECURE=true
APP_AUTH_REFRESH_TOKEN_BODY_ENABLED=false

# SMTP for verification and password reset email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<smtp username or sender address>
MAIL_PASSWORD=<smtp password>
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
APP_EMAIL_MX_CHECK_ENABLED=true
APP_EMAIL_STARTUP_CHECK_ENABLED=true

# FreedomPay LIVE. Use production API, never test-api/sandbox.
PAYMENTS_PROVIDER=freedompay
FREEDOMPAY_BASE_URL=https://api.freedompay.kz
FREEDOMPAY_MERCHANT_ID=<live merchant id>
FREEDOMPAY_SECRET_KEY=<live payment secret>
FREEDOMPAY_PAYOUT_SECRET_KEY=<live payout secret>
FREEDOMPAY_RESULT_URL=https://api.example.com/api/v1/webhooks/freedompay/result
FREEDOMPAY_PAYOUT_RESULT_URL=https://api.example.com/api/v1/webhooks/freedompay/payout-result
FREEDOMPAY_SUCCESS_URL=https://app.example.com/payment/confirmation
FREEDOMPAY_FAILURE_URL=https://app.example.com/payment/failure
FREEDOMPAY_TEST_MODE=0
FREEDOMPAY_RECURRING_LIFETIME_DAYS=156
APP_RECURRING_ENABLED=false
APP_PAYOUT_CARD_BINDING_AMOUNT=100

# Real SMS provider. APP_PHONE_DEV_BYPASS_CODE must stay empty in prod.
SMS_PROVIDER=mobizon
MOBIZON_BASE_URL=https://api.mobizon.kz
MOBIZON_API_KEY=<live Mobizon API key>
MOBIZON_FROM=EcoPay
APP_PHONE_DEV_BYPASS_CODE=
APP_SMS_CODE_TTL_SECONDS=300
APP_SMS_RESEND_COOLDOWN_SECONDS=60
APP_SMS_MAX_ATTEMPTS_PER_HOUR=3
APP_SMS_MAX_VERIFY_ATTEMPTS=5
APP_SMS_MAX_PER_IP_PER_HOUR=10
APP_SMS_MAX_PER_IP_PER_DAY=30

# S3-compatible object storage for uploads
S3_REGION=auto
S3_BUCKET=ecopay-avatars
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<s3 access key>
S3_SECRET_KEY=<s3 secret key>
S3_PATH_STYLE_ACCESS=true

# Production hardening toggles
APP_DEV_AUTO_VERIFY_EMAIL=false
